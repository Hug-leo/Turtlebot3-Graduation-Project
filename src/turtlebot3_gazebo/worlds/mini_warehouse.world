<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <light name="sun_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_front"><pose>0 5 1 0 0 0</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>10 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="wall_back"><pose>0 -5 1 0 0 0</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>10 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="wall_left"><pose>-5 0 1 0 0 1.5708</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>10 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="wall_right"><pose>5 0 1 0 0 1.5708</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>10 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>

    <model name="obs_tl_vert"><pose>-2.5 4 1 0 0 0</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.2 2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    
    <model name="obs_ml_horz"><pose>-4.2 -0.5 1 0 0 0</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>1.5 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 0.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    
    <model name="obs_ml_vert"><pose>-1.0 1.5 1 0 0 0</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.2 2.5 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 2.5 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    
    <model name="obs_cross_v"><pose>2.5 2.0 1 0 0 0</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.2 2.5 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 2.5 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="obs_cross_h"><pose>2.5 2.0 1 0 0 0</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>2.0 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 0.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    
    <model name="obs_mr_horz"><pose>1.5 -1.0 1 0 0 0</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>1.5 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 0.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    
    <model name="obs_br_vert"><pose>4.0 -1.5 1 0 0 0</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.2 1.5 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 1.5 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    
    <model name="obs_bm_vert"><pose>1.0 -4.2 1 0 0 0</pose><static>true</static><link name="link"><collision name="c"><geometry><box><size>0.2 1.5 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 1.5 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>

    <model name="cyl_1">
      <pose>-1.5 1.5 0.5 0 0 0</pose><static>true</static>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>
    
    <model name="cyl_2">
      <pose>3.5 1.5 0.5 0 0 0</pose><static>true</static>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>
    
    <model name="cyl_3">
      <pose>-1.0 -3.5 0.5 0 0 0</pose><static>true</static>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>
    
    <model name="cyl_4">
      <pose>3.0 -3.0 0.5 0 0 0</pose><static>true</static>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>
  </world>
</sdf>
